root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows PowerShell 5.1 reads BOM-less files as ANSI and corrupts Arabic text,
# so every .ps1 keeps its UTF-8 BOM. Do not strip it.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

# Batch files must stay ASCII with CRLF line endings.
[*.{bat,cmd}]
charset = latin1
end_of_line = crlf

[*.cs]
charset = utf-8
end_of_line = crlf

[*.{yml,yaml,json,html,css,js,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
